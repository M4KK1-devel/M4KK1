#!/bin/bash
# M4KK1 4P1 - menuconfig.sh
# Description: TUI configuration menu for the M4KK1 build system.
#              Writes build.config (sourced by build_krn.sh).
#
# Frontends, in order of preference:
#   1. whiptail   (newt TUI, default on most distros)
#   2. dialog     (classic TUI fallback)
#   3. bashmenu   (plain numbered-list menu; works over serial/pipe)
#
# Copyright (c) 2026 Yaku Makki
# SPDX-License-Identifier: 4P1-Custom

# The menu lives in the repo root next to the Makefile, so "cd to the
# script's directory" (not ".." — that wrote build.config to F:\).
cd "$(dirname "$0")"

CONFIG="build.config"

# ── Load existing config (if any) ──
BUILD_MODE="full"
OUTPUT_DIR="output"
QEMU_MEMORY="512"
QEMU_VGA="std"
TEST_SMOKE="yes"
TEST_GRAPHICS="yes"
TEST_DRAG="no"
TEST_RMENU="no"
TEST_PCC="yes"
MAKE_JOBS="$(nproc 2>/dev/null || echo 4)"

[ -f "$CONFIG" ] && . "$CONFIG"

# ── Detect TUI backend ──
if command -v whiptail >/dev/null 2>&1; then
    UI="whiptail"
elif command -v dialog >/dev/null 2>&1; then
    UI="dialog"
else
    UI="bashmenu"
fi

# whiptail draws on stderr; dialog on stdout. Normalize via fd swap.
ui() {
    # $1 = tag, $2 = description
    local tag="$1"; shift
    local desc="$1"; shift
    case "$UI" in
    whiptail) whiptail "$@" "$tag" "$desc" 3>&1 1>&2 2>&3 ;;
    dialog)   dialog   "$@" "$tag" "$desc" ;;
    esac
}

save_config() {
    cat > "$CONFIG" <<EOF
# M4KK1 build configuration — generated by menuconfig
# (sourced by tools/build/build_krn.sh; edit manually if you prefer)
BUILD_MODE="$BUILD_MODE"
OUTPUT_DIR="$OUTPUT_DIR"
QEMU_MEMORY="$QEMU_MEMORY"
QEMU_VGA="$QEMU_VGA"
TEST_SMOKE="$TEST_SMOKE"
TEST_GRAPHICS="$TEST_GRAPHICS"
TEST_DRAG="$TEST_DRAG"
TEST_RMENU="$TEST_RMENU"
TEST_PCC="$TEST_PCC"
MAKE_JOBS="$MAKE_JOBS"
EOF
    echo "Saved $CONFIG"
}

mode_desc() {
    case "$1" in
    full)      echo "Full desktop (graphics + Copland + Sprach + PCC)" ;;
    full-test) echo "Full desktop + autologin + serial test shell" ;;
    cmd-only)  echo "Command-line system (no graphics)" ;;
    minimal)   echo "Minimal kernel (boot banner + halt)" ;;
    recovery)  echo "cmd-only + fsck / reset-passwd tools" ;;
    esac
}

bash_main_menu() {
    while true; do
        echo ""
        echo "╔══════════════════════════════════════════════╗"
        echo "║   M4KK1 Build Configuration                  ║"
        echo "╠══════════════════════════════════════════════╣"
        echo "║ Mode:      $(printf '%-33s' "$BUILD_MODE") ║"
        echo "║ Output:    $(printf '%-33s' "$OUTPUT_DIR") ║"
        echo "║ QEMU mem:  $(printf '%-33s' "${QEMU_MEMORY}MB") ║"
        echo "║ VGA:       $(printf '%-33s' "$QEMU_VGA") ║"
        echo "║ Tests: smoke=$TEST_SMOKE gfx=$TEST_GRAPHICS"
        echo "║        drag=$TEST_DRAG rmenu=$TEST_RMENU"
        echo "╠══════════════════════════════════════════════╣"
        echo "║ 1) Build mode          2) Output directory    ║"
        echo "║ 3) QEMU options        4) Test selection       ║"
        echo "║ 5) Save & exit         6) Discard & exit      ║"
        echo "╚══════════════════════════════════════════════╝"
        printf "Choice [1-6]: "
        read -r choice
        case "$choice" in
        1) bash_choose_mode ;;
        2) printf "Output directory [$OUTPUT_DIR]: "; read -r OUTPUT_DIR
           [ -z "$OUTPUT_DIR" ] && OUTPUT_DIR="output" ;;
        3) printf "QEMU memory MB [$QEMU_MEMORY]: "; read -r QEMU_MEMORY
           [ -z "$QEMU_MEMORY" ] && QEMU_MEMORY=512
           printf "QEMU VGA (std/cirrus/virtio) [$QEMU_VGA]: "; read -r QEMU_VGA
           [ -z "$QEMU_VGA" ] && QEMU_VGA=std ;;
        4) bash_choose_tests ;;
        5) save_config; return 0 ;;
        6) return 0 ;;
        *) echo "Invalid choice" ;;
        esac
    done
}

bash_choose_mode() {
    echo "Build modes:"
    local i=1 modes="full full-test cmd-only minimal recovery"
    for m in $modes; do
        echo "  $i) $m  —  $(mode_desc "$m")"
        i=$((i+1))
    done
    printf "Choice [1-5]: "
    read -r c
    case "$c" in
    1) BUILD_MODE="full" ;;
    2) BUILD_MODE="full-test" ;;
    3) BUILD_MODE="cmd-only" ;;
    4) BUILD_MODE="minimal" ;;
    5) BUILD_MODE="recovery" ;;
    esac
}

bash_choose_tests() {
    echo "Toggle tests (y/n):"
    for t in SMOKE GRAPHICS DRAG RMENU PCC; do
        eval "cur=\$TEST_$t"
        printf "  TEST_$t [$cur]: "
        read -r v
        [ "$v" = "y" ] || [ "$v" = "n" ] && eval "TEST_$t=$v"
    done
}

tui_main_menu() {
    while true; do
        choice=$(ui "M4KK1 Build Configuration" \
            --menu "Mode: $BUILD_MODE ($(mode_desc "$BUILD_MODE"))\nOutput: $OUTPUT_DIR   QEMU: ${QEMU_MEMORY}MB / $QEMU_VGA\nTests: smoke=$TEST_SMOKE gfx=$TEST_GRAPHICS drag=$TEST_DRAG rmenu=$TEST_RMENU pcc=$TEST_PCC" \
            20 76 6 \
            "1" "Build mode" \
            "2" "Output directory" \
            "3" "QEMU options" \
            "4" "Test selection" \
            "5" "Save & exit" \
            "6" "Discard & exit") || { echo "Cancelled."; return 0; }
        case "$choice" in
        1) tui_choose_mode ;;
        2) d=$(ui "Output directory" --inputbox "Directory for ISO artifacts" 8 60 "$OUTPUT_DIR" 2>/dev/null) && OUTPUT_DIR="${d:-output}" ;;
        3) tui_qemu_opts ;;
        4) tui_choose_tests ;;
        5) save_config; return 0 ;;
        6) return 0 ;;
        esac
    done
}

tui_choose_mode() {
    choice=$(ui "Build mode" --menu "Select the build profile" 18 70 5 \
        "full"      "$(mode_desc full)" \
        "full-test" "$(mode_desc full-test)" \
        "cmd-only"  "$(mode_desc cmd-only)" \
        "minimal"   "$(mode_desc minimal)" \
        "recovery"  "$(mode_desc recovery)") || return 0
    BUILD_MODE="$choice"
}

tui_qemu_opts() {
    d=$(ui "QEMU memory" --inputbox "Guest RAM in MB" 8 50 "$QEMU_MEMORY" 2>/dev/null) && QEMU_MEMORY="${d:-512}"
    d=$(ui "QEMU VGA" --menu "Emulated video card" 14 60 3 \
        "std"    "Standard VGA (default, VESA)" \
        "cirrus" "Cirrus Logic GD5446" \
        "virtio" "virtio-gpu") && QEMU_VGA="${d:-std}"
}

tui_choose_tests() {
    # checklist: pre-select entries whose variable is "yes"
    local args=()
    [ "$TEST_SMOKE"   = yes ] && args+=("smoke"   "Boot smoke test (serial, no panic)" "on")  || args+=("smoke"   "Boot smoke test (serial, no panic)" "off")
    [ "$TEST_GRAPHICS" = yes ] && args+=("gfx"     "Graphics bring-up (desktop visible)" "on") || args+=("gfx"     "Graphics bring-up (desktop visible)" "off")
    [ "$TEST_DRAG"    = yes ] && args+=("drag"    "Window drag repro (QEMU HMP)" "on")   || args+=("drag"    "Window drag repro (QEMU HMP)" "off")
    [ "$TEST_RMENU"   = yes ] && args+=("rmenu"   "Right-click context menu repro" "on") || args+=("rmenu"   "Right-click context menu repro" "off")
    [ "$TEST_PCC"     = yes ] && args+=("pcc"     "PCC self-host compile check" "on")    || args+=("pcc"     "PCC self-host compile check" "off")
    sel=$(ui "Test selection" --checklist "Toggle post-build regression tests (space)" \
        18 70 5 "${args[@]}") || return 0
    TEST_SMOKE=no; TEST_GRAPHICS=no; TEST_DRAG=no; TEST_RMENU=no; TEST_PCC=no
    for s in $sel; do
        case "$s" in
        smoke) TEST_SMOKE=yes ;;
        gfx)   TEST_GRAPHICS=yes ;;
        drag)  TEST_DRAG=yes ;;
        rmenu) TEST_RMENU=yes ;;
        pcc)   TEST_PCC=yes ;;
        esac
    done
}

case "$UI" in
whiptail|dialog) tui_main_menu ;;
*) bash_main_menu ;;
esac
