#!/bin/bash
# M4KK1 4P1 - menuconfig
# Description: TUI configuration menu for the M4KK1 build system.
#              Writes build.config (sourced by build_krn.sh).
#
# Frontends, in order of preference:
#   1. python3 curses  (ncurses TUI — no extra packages needed)
#   2. bashmenu        (plain numbered-list menu; serial/pipe safe)
#
# (whiptail/dialog support was dropped: the WSL build host ships
#  neither, so the old script always fell through to bashmenu.)
#
# Copyright (c) 2026 Yaku Makki
# SPDX-License-Identifier: 4P1-Custom

cd "$(dirname "$0")"

CONFIG="build.config"

# ── Load existing config (if any) ──
BUILD_MODE="full"
OUTPUT_DIR="output"
QEMU_MEMORY="512"
QEMU_VGA="std"
TEST_SMOKE="yes"
TEST_GRAPHICS="yes"
TEST_DRAG="no"
TEST_RMENU="no"
TEST_PCC="yes"
MAKE_JOBS="$(nproc 2>/dev/null || echo 4)"

[ -f "$CONFIG" ] && . "$CONFIG"

# ── Detect TUI backend ──
if command -v python3 >/dev/null 2>&1 \
   && python3 -c "import curses" >/dev/null 2>&1; then
    UI="curses"
else
    UI="bashmenu"
fi

save_config() {
    cat > "$CONFIG" <<EOF
# M4KK1 build configuration — generated by menuconfig
# (sourced by tools/build/build_krn.sh; edit manually if you prefer)
BUILD_MODE="$BUILD_MODE"
OUTPUT_DIR="$OUTPUT_DIR"
QEMU_MEMORY="$QEMU_MEMORY"
QEMU_VGA="$QEMU_VGA"
TEST_SMOKE="$TEST_SMOKE"
TEST_GRAPHICS="$TEST_GRAPHICS"
TEST_DRAG="$TEST_DRAG"
TEST_RMENU="$TEST_RMENU"
TEST_PCC="$TEST_PCC"
MAKE_JOBS="$MAKE_JOBS"
EOF
    echo "Saved $CONFIG"
}

mode_desc() {
    case "$1" in
    full)      echo "Full desktop (graphics + Copland + Sprach + PCC)" ;;
    full-test) echo "Full desktop + autologin + serial test shell" ;;
    cmd-only)  echo "Command-line system (no graphics)" ;;
    minimal)   echo "Minimal kernel (boot banner + halt)" ;;
    recovery)  echo "cmd-only + fsck / reset-passwd tools" ;;
    esac
}

# ══════════════ bash fallback menu (unchanged behaviour) ══════════════

bash_main_menu() {
    while true; do
        echo ""
        echo "╔══════════════════════════════════════════════╗"
        echo "║   M4KK1 Build Configuration                  ║"
        echo "╠══════════════════════════════════════════════╣"
        echo "║ Mode:      $(printf '%-33s' "$BUILD_MODE") ║"
        echo "║ Output:    $(printf '%-33s' "$OUTPUT_DIR") ║"
        echo "║ QEMU mem:  $(printf '%-33s' "${QEMU_MEMORY}MB") ║"
        echo "║ VGA:       $(printf '%-33s' "$QEMU_VGA") ║"
        echo "║ Tests: smoke=$TEST_SMOKE gfx=$TEST_GRAPHICS"
        echo "║        drag=$TEST_DRAG rmenu=$TEST_RMENU"
        echo "╠══════════════════════════════════════════════╣"
        echo "║ 1) Build mode          2) Output directory    ║"
        echo "║ 3) QEMU options        4) Test selection       ║"
        echo "║ 5) Save & exit         6) Discard & exit      ║"
        echo "╚══════════════════════════════════════════════╝"
        printf "Choice [1-6]: "
        read -r choice
        case "$choice" in
        1) bash_choose_mode ;;
        2) printf "Output directory [$OUTPUT_DIR]: "; read -r OUTPUT_DIR
           [ -z "$OUTPUT_DIR" ] && OUTPUT_DIR="output" ;;
        3) printf "QEMU memory MB [$QEMU_MEMORY]: "; read -r QEMU_MEMORY
           [ -z "$QEMU_MEMORY" ] && QEMU_MEMORY=512
           printf "QEMU VGA (std/cirrus/virtio) [$QEMU_VGA]: "; read -r QEMU_VGA
           [ -z "$QEMU_VGA" ] && QEMU_VGA=std ;;
        4) bash_choose_tests ;;
        5) save_config; return 0 ;;
        6) return 0 ;;
        *) echo "Invalid choice" ;;
        esac
    done
}

bash_choose_mode() {
    echo "Build modes:"
    local i=1 modes="full full-test cmd-only minimal recovery"
    for m in $modes; do
        echo "  $i) $m  —  $(mode_desc "$m")"
        i=$((i+1))
    done
    printf "Choice [1-5]: "
    read -r c
    case "$c" in
    1) BUILD_MODE="full" ;;
    2) BUILD_MODE="full-test" ;;
    3) BUILD_MODE="cmd-only" ;;
    4) BUILD_MODE="minimal" ;;
    5) BUILD_MODE="recovery" ;;
    esac
}

bash_choose_tests() {
    echo "Toggle tests (y/n):"
    for t in SMOKE GRAPHICS DRAG RMENU PCC; do
        eval "cur=\$TEST_$t"
        printf "  TEST_$t [$cur]: "
        read -r v
        [ "$v" = "y" ] || [ "$v" = "n" ] && eval "TEST_$t=$v"
    done
}

# ══════════════ dispatch ══════════════

case "$UI" in
curses) exec python3 tools/build/tui_menuconfig.py "$@" ;;
*)       bash_main_menu ;;
esac
