# Compiler settings
HOSTCC ?= gcc
HOSTCXX ?= g++
HOSTCFLAGS := -Wall -Wextra -O2 -g
HOSTCXXFLAGS := -Wall -Wextra -O2 -g -std=c++17

# Export variables
export HOSTCC HOSTCXX HOSTCFLAGS HOSTCXXFLAGS

# Common build rules
%.o: %.c
	$(HOSTCC) $(HOSTCFLAGS) -c $< -o $@

%.o: %.cpp
	$(HOSTCXX) $(HOSTCXXFLAGS) -c $< -o $@

%.o: %.asm
	$(AS) $(ASFLAGS) $< -o $@

# Clean rule
.PHONY: clean
clean:
	rm -f *.o *.a *.so *.prg
	rm -rf *.dSYM

# Install rule
.PHONY: install
install: all

# Help rule
.PHONY: help
help:
	@echo "Common build rules"
	@echo "  make all     - Build all targets"
	@echo "  make clean   - Clean build files"
	@echo "  make install - Install build results"
	@echo "  make help    - Show this help"
